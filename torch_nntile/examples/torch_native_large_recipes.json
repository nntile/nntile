{
  "_comment": "Large torch-native recipes: bigger MODELS and INPUTS than middle (*_large_config.json + longer seq / larger images). Steps tuned for ~1 min torch CUDA train-loop wall on NVIDIA A40 (probed 2026-07-21, CUDA_VISIBLE_DEVICES=1). See docs/dev/reproducibility.md.",
  "protocol": {
    "ncpu": 0,
    "ncuda": 1,
    "seed": 0,
    "host_threads": 1,
    "target_cuda_wall_s": 60,
    "env": {
      "OMP_NUM_THREADS": "1",
      "OPENBLAS_NUM_THREADS": "1",
      "MKL_NUM_THREADS": "1",
      "NUMEXPR_NUM_THREADS": "1",
      "STARPU_SILENT": "1",
      "STARPU_FXT_TRACE": "0",
      "STARPU_WORKERS_NOBIND": "1"
    }
  },
  "hf": {
