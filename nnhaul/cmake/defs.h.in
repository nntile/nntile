#pragma once

#include <cstddef>

//! Configure-time DEFAULT class in MiB (used only when the runtime env
//! variable NNHAUL_CHUNK_SIZE_MB is unset).
#define NNHAUL_DEFAULT_CHUNK_SIZE_MB @NNHAUL_DEFAULT_CHUNK_SIZE_MB@

namespace nnhaul
{

//! The process-wide chunk class in its shift/mask form.
//!
//! The class is a power of two, so chunk paging is pure shift/mask:
//! `byte >> shift` names the chunk, `byte & mask` the in-chunk offset.
//! It is fixed for the lifetime of the process (one class, the contract)
//! but is a RUNTIME value, initialized from the NNHAUL_CHUNK_SIZE_MB
//! environment variable on first use.
struct ChunkClass
{
    std::size_t bytes = 0; //!< class size in bytes (a power of two)
    std::size_t mask = 0;  //!< bytes - 1, the AND mask
    int shift = 0;         //!< log2(bytes), the shift count
};

//! The process-wide runtime chunk class. The first call reads
//! NNHAUL_CHUNK_SIZE_MB (a positive power-of-two number of MiB, default
//! NNHAUL_DEFAULT_CHUNK_SIZE_MB) and aborts loudly on a malformed value;
//! every later call returns the same immutable class.
ChunkClass const &chunk_class() noexcept;

//! The class size in bytes.
inline std::size_t chunk_class_bytes() noexcept
{
    return chunk_class().bytes;
}

//! The class AND mask (bytes - 1).
inline std::size_t chunk_class_mask() noexcept
{
    return chunk_class().mask;
}

//! The class shift (log2 bytes).
inline int chunk_class_shift() noexcept
{
    return chunk_class().shift;
}

} // namespace nnhaul
