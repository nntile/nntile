# @file .dockerignore
# NNTile 2.0 file.
#
# @version 2.0.0

.*
build*
# HF weights pulled at runtime, not needed in the image
cache_hf/
**/cache_hf/
# Local tarball extractions from manual host-side builds.
# pip editable metadata from local installs
**/*.egg-info/
**/__pycache__/
