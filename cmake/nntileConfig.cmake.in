# @file cmake/nntileConfig.cmake.in
# find_package(nntile) config for installed libnntile.
# @version 2.0.0

@PACKAGE_INIT@

# Re-entrant find_package / find_dependency must not re-announce or
# re-import targets.
set(NNTILE_BUILT_WITH_CUDA "@NNTILE_LINK_CUDA@")
set(NNTILE_BUILT_WITH_DISABLED_KERNELS "@NNTILE_DISABLED_KERNELS@")

if(TARGET nntile::nntile)
    check_required_components(nntile)
    return()
endif()

include(CMakeFindDependencyMacro)

# The public nntile headers include <nnhaul/nnhaul.hh>, and the link
# interface names nnhaul::nnhaul, so the nnhaul package must be found.
# find_dependency resets PACKAGE_PREFIX_DIR; keep ours for the rest of
# this config.
set(_nntile_saved_prefix "${PACKAGE_PREFIX_DIR}")
find_dependency(nnhaul CONFIG)
set(PACKAGE_PREFIX_DIR "${_nntile_saved_prefix}")
if(TARGET nnhaul::nnhaul)
    get_target_property(_nnhaul_type nnhaul::nnhaul TYPE)
    if(_nnhaul_type STREQUAL "STATIC_LIBRARY")
        message(FATAL_ERROR
            "nntile was built against a shared nnhaul, but "
            "nnhaul::nnhaul here is a static archive: two engine "
            "instances would result. Point CMAKE_PREFIX_PATH at the "
            "nnhaul shared package used to build nntile.")
    endif()
endif()

find_dependency(nlohmann_json)

if(NNTILE_BUILT_WITH_CUDA)
    find_dependency(CUDAToolkit 12.0)
    # The build links CUDNN::cudnn_all; define an equivalent imported
    # target for consumers that do not have the build's cuDNN helper.
    if(NOT TARGET CUDNN::cudnn_all)
        find_path(_nntile_cudnn_include cudnn.h
            HINTS "${CUDNN_ROOT}/include" "$ENV{CUDNN_ROOT}/include")
        find_library(_nntile_cudnn_library cudnn
            HINTS "${CUDNN_ROOT}/lib" "$ENV{CUDNN_ROOT}/lib")
        if(NOT _nntile_cudnn_include OR NOT _nntile_cudnn_library)
            set(nntile_FOUND FALSE)
            set(nntile_NOT_FOUND_MESSAGE
                "nntile was built with CUDA/cuDNN; install cuDNN or set "
                "CUDNN_ROOT")
            check_required_components(nntile)
            return()
        endif()
        add_library(CUDNN::cudnn_all UNKNOWN IMPORTED)
        set_target_properties(CUDNN::cudnn_all PROPERTIES
            IMPORTED_LOCATION "${_nntile_cudnn_library}"
            INTERFACE_INCLUDE_DIRECTORIES "${_nntile_cudnn_include}")
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/nntileTargets.cmake")

if(NOT TARGET nntile::nntile)
    message(FATAL_ERROR "nntile::nntile target missing from nntileTargets.cmake")
endif()

if(NOT nntile_FIND_QUIETLY)
    message(STATUS "libnntile found: ${PACKAGE_PREFIX_DIR}")
endif()

check_required_components(nntile)
