# @file cmake/nntileConfig.cmake.in
# find_package(nntile) config for installed libnntile.

@PACKAGE_INIT@

# Re-entrant find_package / find_dependency must not re-announce or
# re-import targets.
if(TARGET nntile::nntile)
    check_required_components(nntile)
    return()
endif()

include(CMakeFindDependencyMacro)

set(NNTILE_BUILT_WITH_CUDA "@NNTILE_LINK_CUDA@")
set(NNTILE_BUILT_WITH_CBLAS "@NNTILE_LINK_CBLAS@")
set(NNTILE_BUILT_WITH_TORCH_NATIVE_OPS "@NNTILE_TORCH_NATIVE_OPS@")
set(NNTILE_BUILT_WITH_NNTILE_NATIVE_OPS "@NNTILE_NNTILE_NATIVE_OPS@")

# StarPU (same helper used at build time).
include("${CMAKE_CURRENT_LIST_DIR}/NNTileFindStarPU.cmake")

find_dependency(nlohmann_json)

if(NNTILE_BUILT_WITH_CUDA)
    find_dependency(CUDAToolkit 11.0)
    # CUDNN::cudnn_all is provided by the build's cuDNN helper; consumers that
    # need CUDA must supply an equivalent imported target or link flags.
endif()

if(NNTILE_BUILT_WITH_CBLAS)
    find_dependency(BLAS)
endif()

# Torch-native libnntile PUBLIC-links LibTorch; consumers need Torch too.
if(NNTILE_BUILT_WITH_TORCH_NATIVE_OPS)
    find_dependency(Torch)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/nntileTargets.cmake")

if(NOT TARGET nntile::nntile)
    message(FATAL_ERROR "nntile::nntile target missing from nntileTargets.cmake")
endif()

if(NOT nntile_FIND_QUIETLY)
    message(STATUS "libnntile found: ${PACKAGE_PREFIX_DIR}")
    if(NNTILE_BUILT_WITH_TORCH_NATIVE_OPS)
        message(STATUS
            "libnntile: NNTILE_TORCH_NATIVE_OPS=ON")
    endif()
    if(NNTILE_BUILT_WITH_NNTILE_NATIVE_OPS)
        message(STATUS
            "libnntile: NNTILE_NNTILE_NATIVE_OPS=ON")
    endif()
endif()

check_required_components(nntile)
