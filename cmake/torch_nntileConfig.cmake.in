# @file cmake/torch_nntileConfig.cmake.in
# find_package(torch_nntile) config for installed libtorch_nntile.

@PACKAGE_INIT@

if(TARGET torch_nntile::torch_nntile)
    check_required_components(torch_nntile)
    return()
endif()

include(CMakeFindDependencyMacro)

find_dependency(nntile REQUIRED)
find_dependency(Torch REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/torch_nntileTargets.cmake")

if(NOT TARGET torch_nntile::torch_nntile)
    message(FATAL_ERROR
        "torch_nntile::torch_nntile target missing from torch_nntileTargets.cmake")
endif()

if(NOT torch_nntile_FIND_QUIETLY)
    message(STATUS "libtorch_nntile found: ${PACKAGE_PREFIX_DIR}")
endif()

check_required_components(torch_nntile)
